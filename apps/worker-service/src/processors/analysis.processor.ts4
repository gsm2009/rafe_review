import mongoose from 'mongoose';
import type { AnalysisRequestedEvent, Demographics, ThirdPartyApiResponse, AnalysisJob, LogContext } from '@senior-challenge/shared-types';
import type { MessageProcessor } from './processor.interface';
import { captureMiddleware } from '../middleware/capture.middleware';
import { createTracedLogger, logger } from '../shared/logger';
import { ThirdPartyApiResponseSchema, type ValidatedThirdPartyResponse } from '../validation/third-party.schema';
import { saveFailedRecords, type FailedRecord } from '../utils/dead-letter';

const MONGODB_URI = process.env.MONGODB_URI ?? 'mongodb://localhost:27017/analysis_db';

// 批处理统计类型
interface BatchStats {
  processed: number;
  skipped: number;
  failedRecords: FailedRecord[];
}

export class AnalysisProcessor implements MessageProcessor {
  private connection: mongoose.Connection | null = null;
  private batchStats: BatchStats = { processed: 0, skipped: 0, failedRecords: [] };
  // 新增：保存连接 Promise，用于等待
  private connectionPromise: Promise<void>;

  constructor() {
    // 保存初始化 Promise
    this.connectionPromise = this.initializeDatabase();
    // 优雅退出时保存失败记录
    process.on('SIGINT', async () => {
      await this.flushFailedRecords();
      process.exit(0);
    });
  }

  // 新增：暴露给外部的等待连接方法
  public async waitForReady(): Promise<void> {
    await this.connectionPromise;
  }

  private async initializeDatabase(): Promise<void> {
    try {
      await mongoose.connect(MONGODB_URI);
      this.connection = mongoose.connection;
      logger.info({ event: 'DatabaseConnected' });
    } catch (error) {
      logger.error({ event: 'DatabaseConnectionFailed', error: error instanceof Error ? error.message : 'Unknown' });
      throw error; // 抛出错误，让外部知道连接失败
    }
  }

  async process(event: AnalysisRequestedEvent): Promise<void> {
    // 创建带 traceId 的结构化日志
    const log = createTracedLogger({ traceId: event.traceId, jobId: event.jobId });

    await captureMiddleware(event, async () => {
      await this.realProcess(event, log);
    });
  }

  private async realProcess(event: AnalysisRequestedEvent, log: ReturnType<typeof createTracedLogger>): Promise<void> {
    const { jobId, dataUrl, traceId } = event;
    if (!this.connection) {
      const error = 'No database connection';
      log.error({ event: 'ProcessingFailed', error });
      this.batchStats.skipped++;
      this.batchStats.failedRecords.push({
        jobId,
        traceId,
        rawPayload: event,
        error,
        failedAt: new Date().toISOString()
      });
      return;
    }

    try {
      // ==============================================
      // 1. 防竞态：只有 PENDING+version=0 才能处理
      // ==============================================
      const updateProcessing = await this.connection.collection('analysis_jobs').findOneAndUpdate(
        { jobId, status: 'PENDING', version: 0 },
        { $set: { status: 'PROCESSING', updatedAt: new Date().toISOString() }, $inc: { version: 1 } },
        { returnDocument: 'after' }
      );

      if (!updateProcessing.value) {
        log.warn({ event: 'JobAlreadyProcessed', jobId });
        this.batchStats.skipped++;
        return;
      }

      const currentVersion = (updateProcessing.value as AnalysisJob).version;
      log.info({ event: 'JobStarted', currentVersion });

      // ==============================================
      // 2. 调用第三方 API
      // ==============================================
      const rawApiResponse = await this.callThirdPartyApi(dataUrl);
      log.debug({ event: 'ThirdPartyApiResponseReceived', rawResponse: rawApiResponse });

      // ==============================================
      // 3. Zod 运行时校验（核心容错点）
      // ==============================================
      const validationResult = ThirdPartyApiResponseSchema.safeParse(rawApiResponse);
      if (!validationResult.success) {
        const firstError = validationResult.error.issues[0];
        const errorMsg = `${firstError.path.join('.')}: ${firstError.message}`;
        
        log.warn({
          event: 'ValidationFailed',
          field: firstError.path.join('.'),
          rawValue: (rawApiResponse as any)?.[firstError.path[0]],
          error: errorMsg
        });

        this.batchStats.skipped++;
        this.batchStats.failedRecords.push({
          jobId,
          traceId,
          rawPayload: event,
          error: errorMsg,
          failedAt: new Date().toISOString()
        });

        // 标记任务为失败
        await this.connection.collection('analysis_jobs').updateOne(
          { jobId },
          { $set: { status: 'FAILED', error: errorMsg, updatedAt: new Date().toISOString() } }
        );
        return;
      }

      const validatedResponse: ValidatedThirdPartyResponse = validationResult.data;
      log.info({ event: 'ValidationPassed' });

      // ==============================================
      // 4. 转换数据（使用校验后的数据）
      // ==============================================
      const demographics = this.transformApiResponse(validatedResponse);

      // ==============================================
      // 5. 防竞态：只有 PROCESSING+version=1 才能写入结果
      // ==============================================
      const updateCompleted = await this.connection.collection('analysis_jobs').findOneAndUpdate(
        { jobId, status: 'PROCESSING', version: currentVersion },
        { $set: { status: 'COMPLETED', demographics, completedAt: new Date().toISOString(), updatedAt: new Date().toISOString() }, $inc: { version: 1 } },
        { returnDocument: 'after' }
      );

      if (!updateCompleted.value) {
        const error = 'Version or status mismatch when writing result';
        log.error({ event: 'WriteFailed', error });
        this.batchStats.skipped++;
        this.batchStats.failedRecords.push({
          jobId,
          traceId,
          rawPayload: event,
          error,
          failedAt: new Date().toISOString()
        });
        return;
      }

      this.batchStats.processed++;
      log.info({ event: 'JobCompleted' });
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : 'Unknown error';
      log.error({ event: 'ProcessingFailed', error: errorMsg, stack: error instanceof Error ? error.stack : undefined });
      
      this.batchStats.skipped++;
      this.batchStats.failedRecords.push({
        jobId,
        traceId,
        rawPayload: event,
        error: errorMsg,
        failedAt: new Date().toISOString()
      });

      try {
        await this.connection.collection('analysis_jobs').updateOne(
          { jobId, status: 'PROCESSING' },
          { $set: { status: 'FAILED', error: errorMsg, updatedAt: new Date().toISOString() } }
        );
      } catch {}
    }
  }

  // 优雅退出时保存失败记录
  private async flushFailedRecords() {
    if (this.batchStats.failedRecords.length > 0) {
      const result = await saveFailedRecords(this.batchStats.failedRecords);
      logger.info({
        event: 'FailedRecordsSaved',
        batchId: result.batchId,
        filePath: result.filePath,
        count: result.count
      });
    }
    // 打印批处理统计
    logger.info({
      event: 'BatchStats',
      processed: this.batchStats.processed,
      skipped: this.batchStats.skipped
    });
  }

  // 辅助方法保持不变
  private async callThirdPartyApi(dataUrl: string): Promise<ThirdPartyApiResponse> {
    await new Promise(r => setTimeout(r, 500 + Math.random() * 1000));
    const scenarios: ThirdPartyApiResponse[] = [
      { success: true, data: { age: 28, gender: 'female', country: 'US', tags: ['fashion', 'travel'], score: 0.85 } },
      { success: true, data: { age: '25+', gender: 'male', country: 'UK', tags: 'lifestyle,food', score: '0.72' } },
      { success: true, data: { age: null, gender: undefined, country: 'CA', tags: null, score: null } }
    ];
    return scenarios[Math.floor(Math.random() * scenarios.length)];
  }

  private transformApiResponse(response: ValidatedThirdPartyResponse): Demographics {
    const data = response.data || { age: 0, gender: 'unknown', country: 'unknown', tags: [], score: 0 };
    return {
      ageRange: this.calculateAgeRange(data.age),
      gender: data.gender,
      location: data.country,
      interests: data.tags,
      confidence: data.score,
    };
  }

  private calculateAgeRange(age: number): string {
    if (age < 18) return 'under-18';
    if (age < 25) return '18-24';
    if (age < 35) return '25-34';
    if (age < 45) return '35-44';
    if (age < 55) return '45-54';
    return '55+';
  }
}
